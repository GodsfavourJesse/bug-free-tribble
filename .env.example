# ---------------------------------------------------------
# Application
# ---------------------------------------------------------
NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:3000
API_URL=http://localhost:4000
# Extra browser origins allowed by CORS/Socket.IO (comma-separated, optional)
CORS_ORIGINS=
# Reverse-proxy hops in front of the API (0 = none, 1 = one load balancer)
TRUST_PROXY=0
SHUTDOWN_TIMEOUT_MS=15000

# ---------------------------------------------------------
# Database
# ---------------------------------------------------------
DATABASE_URL=postgres://user:password@localhost:5432/karmass
DATABASE_POOL_MAX=20
DATABASE_IDLE_TIMEOUT_MS=10000
DATABASE_CONNECTION_TIMEOUT_MS=10000
# 0 disables the per-statement timeout
DATABASE_STATEMENT_TIMEOUT_MS=30000
# disable | verify | no-verify  (default: verify in production, disable otherwise)
DATABASE_SSL=

# ---------------------------------------------------------
# Session / cookies
# ---------------------------------------------------------
SESSION_COOKIE_NAME=karmass_session
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=
SESSION_TTL_DAYS=30
# Production: SESSION_COOKIE_SECURE=true (required).
# Use SESSION_COOKIE_SAME_SITE=none when the web client is on a different site than the API.
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAME_SITE=lax

# ---------------------------------------------------------
# HTTP
# ---------------------------------------------------------
JSON_BODY_LIMIT=1mb
URL_ENCODED_BODY_LIMIT=1mb

# ---------------------------------------------------------
# Rate limiting
# ---------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=300
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX_REQUESTS=20

# ---------------------------------------------------------
# Email (required in production)
# ---------------------------------------------------------
EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_VERIFICATION_TTL_MINUTES=30

# ---------------------------------------------------------
# Payments (Paystack signs webhooks with the secret key)
# ---------------------------------------------------------
PAYSTACK_SECRET_KEY=

# ---------------------------------------------------------
# Cloudinary
# ---------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=karmass

# ---------------------------------------------------------
# Logging
# ---------------------------------------------------------
LOG_LEVEL=info

# ---------------------------------------------------------
# Uploads
# ---------------------------------------------------------
MAX_IMAGE_SIZE_MB=10
MAX_IMAGES_PER_LISTING=20

# ---------------------------------------------------------
# Worker
# ---------------------------------------------------------
WORKER_POLL_MS=1000

AUTH_LOGIN_MAX_ATTEMPTS=
AUTH_LOGIN_WINDOW_MINUTES=
AUTH_LOGIN_LOCKOUT_MINUTES=

AUTH_VERIFICATION_MAX_ATTEMPTS=
AUTH_VERIFICATION_RESEND_COOLDOWN_SECONDS=
AUTH_VERIFICATION_MAX_RESENDS_PER_HOUR=

PASSWORD_RESET_TTL_MINUTES=
PASSWORD_RESET_RESEND_COOLDOWN_SECONDS=
